# Server Configuration
PORT=5000
# In production on Render/Railway/Fly, set NODE_ENV=production
NODE_ENV=production

# Allowed Frontend Origins for CORS
# Single origin:
CLIENT_ORIGIN=http://localhost:5173
# Or multiple origins (comma-separated):
# CLIENT_ORIGINS=http://localhost:5173,https://your-deployed-frontend.com

# MongoDB Atlas Connection String (Atlas Network Access: whitelist 0.0.0.0/0 for Render)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=Cluster0

# JWT Session Secret (Required for secure HTTP-only cookies)
SESSION_SECRET=your_super_secret_session_key_here

# Admin Credentials (optional overrides)
# ADMIN_EMAIL=yeshuv24@gmail.com
# ADMIN_PASSWORD=Kalavathi@312
